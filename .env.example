# Copy this file to .env.local and paste your key.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OPTIONAL — enables the flight-search tool (find_flights).
# Without this key the app runs exactly the same, just with no flight prices (graceful degradation).
# Grab a FREE Duffel TEST token (no credit card): sign up at https://app.duffel.com/join, then
# Dashboard → Developers → Access tokens → create a TEST token (it starts with "duffel_test_").
# NOTE: test-mode fares are SYNTHETIC (a fake test airline) and are labelled "test data" in the UI —
# they prove the integration, not real prices. A live Duffel token returns real fares with no
# disclaimer (going live needs Duffel verification — not required for learning/testing).
DUFFEL_API_KEY=

# OPTIONAL — your home/display currency (ISO 4217). Budgets (always computed in USD) and flight
# fares (quoted by Duffel in its own currency) are shown in this currency, converted at live
# European Central Bank reference rates (keyless, via Frankfurter). Defaults to AUD. Set to USD to
# see everything in US dollars (the budget is already USD; a fare Duffel quotes in another currency
# is still converted to USD). An invalid value falls back to AUD. No key needed — just a preference.
HOME_CURRENCY=AUD
